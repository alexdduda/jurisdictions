# The policy per domain with the lowest expected regret across all sampled worlds.
# 200 sampled worlds per domain, 3 seeds each.

scope nation {
  law schools: preempt = 0.3            # wins 62% of worlds; keeps 21% of the tailored gain
  law environment: preempt = 0.3        # wins 75% of worlds; keeps 90% of the tailored gain
  law transit: preempt = 0.4            # wins 97% of worlds; keeps 86% of the tailored gain
  law redistribution: preempt = 0.25    # wins 98% of worlds; keeps 87% of the tailored gain
}
