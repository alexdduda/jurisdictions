# The policy per domain with the lowest expected regret across all sampled worlds.
# 200 sampled worlds per domain, 3 seeds each.

scope nation {
  law schools: shadow                   # no rule clearly wins; best (equalized 100%) keeps 2%
  law environment: preempt = 0.3        # wins 57% of worlds; keeps 59% of the tailored gain
  law transit: preempt = 0.4            # wins 77% of worlds; keeps 57% of the tailored gain
  law redistribution: preempt = 0.25    # wins 98% of worlds; keeps 87% of the tailored gain
}
